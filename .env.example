# Neon pooled connection string (runtime)
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/inspect?sslmode=require"
# Neon direct (non-pooled) connection string (Prisma migrations / db push)
DIRECT_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/inspect?sslmode=require"

# Session signing secret. Min 32 chars. Generate: openssl rand -base64 48
JWT_SECRET="change-me-to-a-random-string-at-least-32-characters-long"

# Google Maps JavaScript API key (Maps JavaScript API enabled, referrer-restricted).
# Public by nature — restrict it by HTTP referrer in Google Cloud Console.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""

# First super-admin, created by the seed on first run.
SEED_ADMIN_USERNAME="admin"
SEED_ADMIN_PASSWORD="change-me-immediately"
SEED_ADMIN_NAME="Super Admin"
